# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
CLAUSEPROOF_MODEL=glm-5.3

# GLM-5.3 思考功能强制开启，抽取任务用 low 即可
# max 会显著增加输出 token 与延迟（输出单价 ¥28/百万）
CLAUSEPROOF_PROTOCOL=openai
CLAUSEPROOF_REASONING_EFFORT=low
CLAUSEPROOF_MAX_TOKENS=8192
CLAUSEPROOF_TEMPERATURE=0
